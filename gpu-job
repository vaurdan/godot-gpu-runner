#!/bin/bash
# gpu-job: run one Godot job on a disposable Vast.ai GPU and fetch the result, retrying infrastructure failures.
# Usage: gpu-job <repo_dir> <full_commit_sha> <project_subdir|.> <out_dir> -- <godot args...>
# Example: gpu-job /root/workspace/night-shift 3f2a...40hex game /root/runs/x -- \
#            --resolution 1920x1080 --fixed-fps 30 --write-movie /job/out/run.avi --quit-after 300
# Each attempt is gpu-job-once (see its header for env vars: GPU_QUERY, GPU_MAX_DPH, GPU_TTL, JOB_TIMEOUT, GPU_MACHINE...).
# Retried on a fresh machine: no offer (69), never running (75), result missing (76), no NVIDIA Vulkan (77).
# Not retried: Godot exit codes (reported in exit_code, gpu-job still exits 0), bad arguments, local errors.
# Env: GPU_ATTEMPTS (default 3), GPU_RETRY_SLEEP (seconds before retrying "no offer", default 60).
# Machines with 2 infra failures in 24 h are skipped automatically (/var/lib/gpu-job/bad-machines.log).
ONCE=${GPU_JOB_ONCE:-/usr/local/bin/gpu-job-once}
N=${GPU_ATTEMPTS:-3}; EXCL="${GPU_EXCLUDE:-}"
mkdir -p "$4"; LOG="$4/gpu-job.log"
for i in $(seq 1 "$N"); do
  [ "$i" -gt 1 ] && echo "gpu-job: attempt $i/$N (excluding machines:${EXCL:- none})" | tee -a "$LOG" >&2
  GPU_EXCLUDE="$EXCL" "$ONCE" "$@"; RC=$?
  case $RC in
    69) [ "$i" -lt "$N" ] && sleep "${GPU_RETRY_SLEEP:-60}" ;;
    75|76|77) EXCL="$EXCL $(cat "$4/.failed-machine" 2>/dev/null)"; rm -f "$4/.failed-machine" ;;
    *) exit $RC ;;
  esac
done
echo "gpu-job: giving up after $N attempts (last rc=$RC)" | tee -a "$LOG" >&2
exit $RC
